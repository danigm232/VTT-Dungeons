; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="Pecio de las Rosas 2.5D"
config/description="Prototipo 2.5D en Godot 4 del Pecio Rosa de los Vientos (Dungeons VTT)"
run/main_scene="res://loading/loading_boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/tokens/cleric.png"

[autoload]

SkillLoading="*res://loading/loading_coordinator.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
occlusion_culling/use_occlusion_culling=true

[editor_plugins]

enabled=PackedStringArray("res://addons/character_workshop/plugin.cfg")
