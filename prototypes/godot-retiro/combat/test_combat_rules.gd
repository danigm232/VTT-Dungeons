extends SceneTree
const Rules=preload("res://combat/combat_rules.gd")
const Catalogue=preload("res://combat/combat_catalogue.gd")
var passed:=0
var failed: Array[String]=[]

func check(value: bool,label: String) -> void:
	if value: passed+=1
	else: failed.append(label); printerr("FAIL: ",label)

func fixture():
	var game=Rules.new()
	game.register({"id":"maria","name":"Trinity","kind":"player","hp":9,"hp_max":9,"ac":14,"speed":7.5,"position":Vector3.ZERO},Catalogue.actions("maria"),Catalogue.profile("maria"))
	game.register({"id":"aoife","name":"Silverfarben","kind":"player","hp":7,"hp_max":7,"ac":12,"speed":7.5,"position":Vector3(1.5,0,0)},Catalogue.actions("aoife"),Catalogue.profile("aoife"))
	game.register({"id":"enemy","name":"Enemigo","kind":"enemy","hp":30,"hp_max":30,"ac":10,"speed":9.0,"position":Vector3(1.5,0,0)},[Catalogue.weapon("sword","Espada",3,"1d6",1,"cortante",1.5)])
	return game

func start(game) -> void:
	game.start(["maria","aoife","enemy"])
	game.submit_initiative("maria",18); game.submit_initiative("aoife",14); game.submit_initiative("enemy",8)

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var game=fixture()
	check(game.start(["maria","aoife","enemy"]),"manual encounter begins")
	check(game.initiative_pending and game.current_id()=="","never invent initiative")
	check(not game.declare("maria","dagger","enemy"),"attacks blocked during initiative")
	check(game.submit_initiative("maria",18),"physical initiative")
	check(not game.submit_initiative("maria",20),"no duplicate initiative")
	game.submit_initiative("aoife",14); check(game.initiative_pending,"wait for all actors")
	game.submit_initiative("enemy",8); check(game.current_id()=="maria","ordered by entered total")
	check(game.timeline().size()==7,"current plus six previews")
	check(not game.next_turn("aoife"),"cannot end another player's turn")
	check(game.declare("maria","dagger","enemy"),"choose real dagger")
	var events: Array=[]; game.resolved.connect(func(event): events.append(event))
	check(events.is_empty(),"selection emits no attack animation")
	check(game.cancel() and not game.actors.maria.action_used,"cancel before dice keeps resources")
	game.declare("maria","dagger","enemy")
	check(not game.submit(25,"maria","invalid"),"invalid d20 rejected")
	check(not game.submit(12,"aoife","wrong"),"physical roll belongs to owner")
	check(game.submit(12,"maria","attack"),"attack die confirmed")
	check(game.pending.kind=="damage" and events.is_empty(),"animation waits until damage")
	check(not game.cancel(),"no cancelling a known hit to reroll")
	check(not game.submit(9,"maria","invalid-damage"),"impossible damage rejected")
	check(game.submit(4,"maria","damage"),"physical damage applied")
	check(game.actors.enemy.hp==23 and events.size()==1,"correct damage and one visual event")
	check(game.submit(4,"maria","damage") and game.actors.enemy.hp==23,"retry cannot duplicate damage")
	check(not game.declare("maria","dagger","enemy"),"one ordinary action per turn")
	game.next_turn("maria"); check(game.current_id()=="aoife","next physical turn")
	check(game.basic("aoife","dash"),"dash executes in one click")
	check(is_equal_approx(game.actors.aoife.movement,15.0),"dash adds actual speed")
	check(game.spend_movement("aoife",2,true) and is_equal_approx(game.actors.aoife.movement,11.0),"difficult ground costs double")
	game.actors.aoife.conditions.append("derribada")
	check(game.spend_movement("aoife",1,true) and is_equal_approx(game.actors.aoife.movement,8.0),"crawling and difficult terrain add their extra costs")
	check(not game.spend_movement("maria",1),"wrong turn cannot move")
	game.finish(); check(not game.active,"explicit end")
	game=fixture(); start(game); game.next_turn("maria")
	check(game.declare("aoife","magic-missile","enemy"),"automatic spell needs no attack die")
	var missile_events: Array=[]; game.resolved.connect(func(event): missile_events.append(event))
	check(game.pending.kind=="damage","magic missile requests physical damage")
	game.submit(2,"aoife","dart1")
	check(missile_events.is_empty(),"multiattack animation waits for all remaining physical dice")
	check(game.actors.aoife.resources["spell-slot-1"].current==1,"first dart spends one slot")
	game.declare("aoife","magic-missile","enemy"); game.submit(3,"aoife","dart2")
	game.declare("aoife","magic-missile","enemy"); game.submit(4,"aoife","dart3")
	check(game.actors.aoife.resources["spell-slot-1"].current==1,"three darts share the same slot and action")
	check(game.actors.enemy.hp==18,"all three individual physical dart rolls")
	check(missile_events.size()==3 and game.visual_queue.is_empty(),"all three projectile visuals release only when sequence is resolved")
	game=fixture(); start(game); game.next_turn("maria")
	game.declare("aoife","fog-cloud","",{"point":Vector3(3,0,0)})
	check(game.cancel() and game.actors.aoife.resources["spell-slot-1"].current==2,"cancel utility spell without spending slot")
	game.declare("aoife","fog-cloud","",{"point":Vector3(3,0,0)})
	game.submit(1,"aoife","fog")
	check(game.effects.size()==1 and game.effects[0].radius==6.0,"real 6 metre concentration fog")
	game.end_concentration("aoife"); check(game.effects.is_empty(),"concentration removes its world effect")
	game=fixture(); start(game); game.next_turn("maria")
	game.declare("aoife","fog-cloud","",{"point":Vector3(3,0,0)}); game.submit(1,"aoife","duration-fog")
	game.advance_time(3599); check(game.effects.size()==1,"fog persists for its legal duration")
	game.advance_time(1); check(game.effects.is_empty() and game.actors.aoife.concentration=="","fog expires on campaign time, including rests")
	game=fixture(); start(game)
	game.damage("enemy",30,"perforante"); game._auto_end()
	check(not game.active and game.actors.enemy.hp==0 and game.actors.enemy.defeat_style=="blood","last enemy automatically ends combat; corpse stays")
	game=fixture(); game.damage("enemy",40,"contundente",false,true)
	check(game.actors.enemy.hp==1 and not game.actors.enemy.dead and game.actors.enemy.defeated,"table nonlethal rule leaves 1 HP and unconscious")
	game=fixture(); game.damage("maria",10,"cortante")
	check(game.actors.maria.hp==0 and not game.actors.maria.dead,"players at zero are not automatically killed")
	game.heal("maria",2); check(not game.actors.maria.defeated and game.actors.maria.hp==2,"healing restores the same actor")
	game=fixture(); start(game); game.damage("maria",10,"cortante"); game.damage("aoife",8,"cortante"); game._auto_end()
	check(game.active,"a downed party still gets death saves; zero HP is not a TPK")
	game.next_turn("maria"); game.submit(20,"aoife","party-death-save")
	check(game.actors.aoife.hp==1 and not game.actors.aoife.dead,"a natural twenty can recover a downed party member")
	check(game.actors.aoife.movement>0,"natural-twenty recovery restores the movement budget for that turn")
	game=fixture(); start(game); game.damage("maria",10,"cortante")
	for index in range(3):
		game.next_turn("maria"); game.next_turn("aoife"); game.next_turn("enemy"); game.submit(10,"maria","stable-%d" % index)
	check(game.actors.maria.stable and game.actors.maria.death_success==0 and game.actors.maria.death_failure==0,"stabilizing resets both death-save counters")
	game.damage("maria",1,"cortante")
	check(not game.actors.maria.stable and game.actors.maria.death_failure==1,"damage to a stable zero-HP character resumes death saves")
	game=fixture(); start(game)
	game.actors.maria.position=Vector3(100,0,0)
	check(not game.declare("maria","dagger","enemy"),"range is checked in map metres")
	check(not game.basic("aoife","dodge"),"cannot dodge out of turn")
	game.actors.maria.position=Vector3.ZERO
	check(game.request_basic("maria","hide","Sigilo"),"skill action requests DM resolution")
	check(game.cancel() and not game.actors.maria.action_used,"cancelling skill does not consume action")
	game.request_basic("maria","ready","Preparar"); game.submit(1,"maria","ready")
	check(game.actors.maria.stance=="ready" and game.actors.maria.action_used,"preparing costs action, not reaction")
	check(Catalogue.load_data().icons.size()>=247,"shared original icon catalogue")
	check(Catalogue.actions("aoife").filter(func(action): return str(action.id).begins_with("fog-cloud")).size()==1,"combat and exploration share a single fog entry in the wheel")
	_reactions()
	_interrupted_sequences()
	_npcs()
	for repetition in range(6): _duel(repetition)
	print(JSON.stringify({"passed":passed,"failed":failed.size(),"errors":failed}))
	quit(0 if failed.is_empty() else 1)

func _reactions() -> void:
	var game=fixture()
	game.register({"id":"mike","kind":"player","hp":100,"hp_max":100,"ac":12,"position":Vector3.ZERO},Catalogue.actions("mike"),{"resources":{"spell-slot-1":{"current":2}}})
	game.start(["enemy","mike"]); game.submit_initiative("enemy",20); game.submit_initiative("mike",10)
	game.declare("enemy","sword","mike"); game.submit(10,"enemy","swing")
	check(game.pending.kind=="damage","shield can interrupt a confirmed hit")
	check(game.react("mike","shield","mike","impact"),"shield reaction opens DM confirmation")
	check(game.cancel() and game.pending.kind=="damage","cancel reaction restores interrupted attack")
	game.react("mike","shield","mike","impact"); game.submit(1,"mike","shield")
	check(game.pending.is_empty() and game.actors.mike.hp==100,"shield turns a marginal hit into a miss")
	check(game.actors.mike.reaction_used and game.actors.mike.ac==17,"shield spends reaction and changes real AC")
	game.next_turn("enemy")
	check(game.actors.mike.ac==12 and not game.actors.mike.reaction_used,"shield expires and reaction resets at start of own turn")
	game=fixture(); start(game)
	check(not game.react("aoife","fire-bolt","enemy","impact"),"ordinary spells cannot masquerade as reactions")
	check(game.react("enemy","sword","maria","opportunity"),"opportunity permits a melee attack out of turn")
	game.submit(1,"enemy","opportunity-miss")
	check(game.actors.enemy.reaction_used and not game.actors.enemy.action_used,"opportunity spends only reaction")
	check(not game.react("enemy","sword","maria","opportunity"),"reaction cannot be used twice")
	game=fixture(); start(game)
	game.request_basic("maria","ready","Preparar"); game.submit(1,"maria","ready")
	game.next_turn("maria")
	check(game.react("maria","dagger","enemy","ready"),"prepared attack uses later reaction")
	game.submit(1,"maria","prepared-miss")
	check(game.actors.maria.action_used and game.actors.maria.reaction_used,"ready action and later reaction are both accounted")
	game=fixture(); start(game); game.next_turn("maria")
	game.actors.aoife.concentration="fog-cloud"
	game.damage("aoife",2,"fuerza"); game._next_followup()
	check(game.pending.kind=="concentration" and game.pending.dc==10,"damage requests physical concentration save")
	game.submit(1,"aoife","concentration")
	check(game.actors.aoife.concentration=="","failed concentration removes spell")
	game=fixture(); start(game)
	game.actors.maria.ammunition={"arrow":1,"dagger":1}
	game.declare("maria","shortbow","enemy"); game.submit(1,"maria","arrow-miss")
	check(game.actors.maria.ammunition.arrow==0,"a missed shot also consumes ammunition")
	game.actors.maria.action_used=false
	check(not game.declare("maria","shortbow","enemy"),"empty quiver blocks another shot")
	game=fixture(); start(game)
	game.actors.maria.action_used=true; game.withdraw("enemy")
	check(game.actors.maria.action_used,"withdrawing another actor cannot recharge current action")
	game=fixture(); game.damage("maria",10,"fuerza")
	game.damage("maria",0,"fuerza")
	check(game.actors.maria.death_failure==0,"zero damage never adds a death failure")
	game=fixture(); start(game)
	game.declare("maria","dagger","enemy",{"sneak":true}); game.submit(20,"maria","critical")
	check(game.damage_bounds(game.pending.action,true,true,"maria")==Vector2i(4,20),"critical doubles both weapon and sneak dice")
	check(game.pending.label.contains("1d6 furtivo") and game.pending.label.contains("TODOS"),"critical prompt explicitly requests weapon and sneak dice")
	game.submit(20,"maria","critical-damage")
	check(game.actors.maria.sneak_turn==game.turn_serial,"sneak is recorded only when hit resolves")
	game=fixture(); start(game); game.next_turn("maria")
	game.request_basic("aoife","ready","Preparar misil","magic-missile"); game.submit(1,"aoife","prepare-spell")
	check(game.actors.aoife.resources["spell-slot-1"].current==1 and game.actors.aoife.concentration=="ready:magic-missile","prepared spell spends slot and starts concentration immediately")
	game.next_turn("aoife")
	check(game.react("aoife","magic-missile","enemy","ready"),"prepared spell releases on another actor's turn")
	game.submit(2,"aoife","ready-dart-1")
	check(game.declare("aoife","magic-missile","enemy"),"next prepaid dart remains part of the same reaction")
	game.submit(2,"aoife","ready-dart-2"); game.declare("aoife","magic-missile","enemy"); game.submit(2,"aoife","ready-dart-3")
	check(game.actors.aoife.resources["spell-slot-1"].current==1 and game.actors.aoife.reaction_used and game.sequence.is_empty(),"prepared volley spends one slot total and one reaction")
	check(game.actors.aoife.concentration=="","released instantaneous spell ends preparation concentration")
	game=fixture(); start(game); game.next_turn("maria")
	game.request_basic("aoife","ready","Preparar niebla","fog-cloud"); game.submit(1,"aoife","prepare-fog")
	game.next_turn("aoife")
	game.react("aoife","fog-cloud","","ready",{"point":Vector3(3,0,0)}); game.submit(1,"aoife","release-fog")
	check(game.effects.size()==1 and game.actors.aoife.concentration=="fog-cloud" and game.actors.aoife.resources["spell-slot-1"].current==1,"prepared area spell hands concentration to the actual spell without charging twice")
	game=fixture(); start(game); game.next_turn("maria")
	game.request_basic("aoife","ready","Preparar misil","magic-missile"); game.submit(1,"aoife","hold-missile")
	game.damage("aoife",2,"fuerza"); game._next_followup(); game.submit(1,"aoife","lose-readied-concentration")
	check(game.actors.aoife.readied_action=="" and game.actors.aoife.resources["spell-slot-1"].current==1,"lost preparation concentration loses the held spell without refund")
	game=fixture()
	game.register({"id":"mia","kind":"player","hp":11,"hp_max":11,"position":Vector3.ZERO},Catalogue.actions("mia"))
	game.declare("mia","sacred-flame","enemy")
	check(game.pending.save_uses_total and game.submit(22,"enemy","unknown-save-total"),"unknown NPC save modifier requires a DM-confirmed total instead of invented zero")

func _interrupted_sequences() -> void:
	var game=fixture()
	var multi: Dictionary=Catalogue.weapon("multi","Dos ataques",3,"1d6",1,"cortante",1.5); multi.attackCount=2
	game.actors.enemy.actions=[multi]
	game.register({"id":"mike","kind":"player","hp":100,"hp_max":100,"ac":12,"position":Vector3.ZERO},Catalogue.actions("mike"),{"resources":{"spell-slot-1":{"current":2}}})
	game.start(["enemy","mike"]); game.submit_initiative("enemy",20); game.submit_initiative("mike",10)
	game.declare("enemy","multi","mike"); game.submit(10,"enemy","multi-1-hit"); game.submit(4,"enemy","multi-1-damage")
	game.declare("enemy","multi","mike"); game.submit(10,"enemy","multi-2-hit")
	game.react("mike","shield","mike","impact")
	check(game.cancel() and game.sequence.remaining==1 and game.visual_queue.size()==1,"cancelling reaction restores the original multiattack and its buffered visuals")
	game.react("mike","shield","mike","impact"); game.submit(1,"mike","multi-shield")
	check(game.actors.mike.hp==95 and game.sequence.is_empty(),"shield blocks second strike without losing or replaying first strike")
	check(game.actors.enemy.action_used and not game.declare("enemy","multi","mike"),"reaction cannot recharge the interrupted attack action")
	game=fixture()
	game.register({"id":"mike","kind":"player","hp":100,"hp_max":100,"ac":12,"position":Vector3.ZERO},Catalogue.actions("mike"),{"resources":{"spell-slot-1":{"current":2}}})
	game.start(["aoife","mike"]); game.submit_initiative("aoife",20); game.submit_initiative("mike",10)
	game.declare("aoife","magic-missile","mike"); game.submit(2,"aoife","missile-before-shield")
	check(not game.spend_movement("aoife",1),"instantaneous spell cannot move its origin between darts")
	game.declare("aoife","magic-missile","mike"); game.react("mike","shield","mike","impact"); game.submit(1,"mike","missile-shield")
	check(game.sequence.get("remaining",0)==1 and game.actors.mike.hp==97,"shield reaction preserves the remaining missile count")
	check(game.declare("aoife","magic-missile","mike") and game.pending.kind=="blocked","active shield also blocks later darts without damage dice")
	game.submit(1,"aoife","blocked-last-dart")
	check(game.actors.mike.hp==97 and game.actors.aoife.resources["spell-slot-1"].current==1 and game.actors.mike.resources["spell-slot-1"].current==1,"missile and shield each spend exactly one slot")
	game=fixture(); game.actors.enemy.actions=[multi]; start(game); game.next_turn("maria")
	game.request_basic("aoife","ready","Preparar misil","magic-missile"); game.submit(1,"aoife","prepare-interrupting-spell"); game.next_turn("aoife")
	game.declare("enemy","multi","aoife"); game.submit(1,"enemy","original-first-miss")
	game.react("aoife","magic-missile","enemy","ready")
	for index in range(3):
		if index>0: game.declare("aoife","magic-missile","enemy")
		game.submit(2,"aoife","reaction-dart-%d" % index)
	check(game.sequence.get("actor","")=="enemy" and game.sequence.get("remaining",0)==1 and game.interrupted.is_empty(),"prepared multi-dart spell returns to the original actor's unfinished action")
	check(game.declare("enemy","multi","aoife"),"interrupted actor can still make its second attack")
	game.submit(1,"enemy","original-second-miss")
	check(game.sequence.is_empty() and game.actors.aoife.resources["spell-slot-1"].current==1,"finishing original action does not charge prepared spell again")
	game=fixture(); start(game); game.next_turn("maria"); game.actors.aoife.hp=2
	game.declare("aoife","magic-missile","aoife"); game.submit(2,"aoife","self-dart-1")
	check(game.actors.aoife.hp==0 and game.declare("aoife","magic-missile","aoife"),"already cast darts can finish even if the caster falls during their resolution")
	game.submit(2,"aoife","self-dart-2"); game.declare("aoife","magic-missile","aoife"); game.submit(2,"aoife","self-dart-3")
	check(game.pending.is_empty() and game.sequence.is_empty(),"fallen caster cannot lock an unfinished instantaneous spell")

func _npcs() -> void:
	var game=fixture()
	game.register({"id":"zombie","kind":"enemy","hp":22,"hp_max":22,"ac":8,"position":Vector3.ZERO},Catalogue.actions("zombie"),Catalogue.profile("zombie"))
	game.start(["maria","zombie"]); game.submit_initiative("maria",20); game.submit_initiative("zombie",10)
	game.damage("zombie",22,"perforante"); game._next_followup(); game._auto_end()
	check(game.active and game.pending.kind=="fortitude","undead fortitude interrupts automatic encounter end")
	check(game.pending.dc==27,"undead fortitude uses received damage in DC")
	game.submit(20,"zombie","fortitude-fail")
	check(not game.active and game.actors.zombie.dead,"failed fortitude ends encounter after physical save")
	game=fixture()
	game.register({"id":"harpy","kind":"enemy","hp":38,"hp_max":38,"position":Vector3.ZERO},Catalogue.actions("harpy"),Catalogue.profile("harpy"))
	game.start(["harpy","maria"]); game.submit_initiative("harpy",20); game.submit_initiative("maria",10)
	game.declare("harpy","harpy-multiattack","maria"); game.submit(1,"harpy","claws-miss")
	check(game.declare("harpy","harpy-club","maria"),"harpy follows claws with club for the same action")
	game.submit(1,"harpy","club-miss")
	check(not game.declare("harpy","harpy-club","maria"),"harpy cannot add an extra club attack")
	game=fixture(); game.actors.enemy.hp=10000; game.actors.enemy.hp_max=10000
	game.register({"id":"anteros","kind":"enemy","hp":71,"hp_max":71,"position":Vector3.ZERO},Catalogue.actions("anteros-temple"),Catalogue.profile("anteros-temple"))
	game.actors.aoife.hp=10000; game.actors.aoife.hp_max=10000
	game.start(["anteros","aoife"]); game.submit_initiative("anteros",20); game.submit_initiative("aoife",10)
	for i in range(6):
		check(game.declare("anteros","radiant-arrows","aoife"),"radiant volley shot %d" % i)
		game.submit(1,"anteros","volley-%d" % i)
	check(not game.declare("anteros","radiant-arrows","aoife"),"six shots spend action and recharge")
	game.next_turn("anteros"); game.next_turn("aoife")
	check(game.pending.kind=="recharge","next turn requests physical recharge d6")
	game.submit(6,"anteros","recharge")
	check(game.actors.anteros.recharge["radiant-arrows"],"natural six restores radiant volley")

func _duel(repetition: int) -> void:
	# Deterministic fixture input emulates physical results; gameplay never rolls.
	var game=Rules.new()
	game.register({"id":"aoife","kind":"player","hp":8,"hp_max":8,"ac":12,"position":Vector3.ZERO},Catalogue.actions("aoife"),Catalogue.profile("aoife"))
	game.register({"id":"anteros","kind":"enemy","hp":71,"hp_max":71,"ac":16,"position":Vector3(1.5,0,0)},Catalogue.actions("anteros-temple"),Catalogue.profile("anteros-temple"))
	game.start(["aoife","anteros"]); game.submit_initiative("aoife",20); game.submit_initiative("anteros",10)
	var turns:=0
	while game.active and turns<30:
		var id: String=game.current_id(); var action: String="fire-bolt" if id=="aoife" else "longsword"; var target: String="anteros" if id=="aoife" else "aoife"
		game.declare(id,action,target)
		game.submit(19 if id=="aoife" and repetition%2==0 else 1,id,"attack-%d" % turns)
		if game.pending.get("kind","")=="damage": game.submit(10,id,"damage-%d" % turns)
		if game.active: game.next_turn(id)
		turns+=1
	check(game.pending.is_empty(),"duel %d never leaves a dice lock" % repetition)
	if repetition%2==0: check(not game.active and game.actors.anteros.dead,"duel %d ends automatically with retained enemy corpse" % repetition)
	else:
		game.finish("DM cancels duel"); check(not game.active,"duel %d can be ended after misses" % repetition)
