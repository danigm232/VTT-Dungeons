{
  "name": "dnd-immersive-engine",
  "version": "0.3.2-dev.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "audio": "node scripts/generate-audio.mjs",
    "build:client": "node node_modules/vite/bin/vite.js build --configLoader runner",
    "build:server": "node node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "build": "node scripts/generate-audio.mjs && node node_modules/vite/bin/vite.js build --configLoader runner && node node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "dev": "node node_modules/tsx/dist/cli.mjs apps/server/index.ts",
    "start": "node dist/server/apps/server/index.js",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts --configLoader runner",
    "test:integration": "node scripts/run-integration.mjs",
    "test:objects": "node scripts/run-object-integration.mjs",
    "test:save": "node scripts/alpha03-smoke.mjs",
    "test:oneshot": "node scripts/one-shot-smoke.mjs",
    "test:d8-combat": "node scripts/d8-combat-integration.mjs",
    "audit:alpha02": "node scripts/audit-alpha02.mjs",
    "audit:alpha021": "node scripts/audit-alpha021.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.26.0",
    "@babylonjs/loaders": "9.26.0",
    "express": "5.1.0",
    "howler": "2.2.4",
    "nipplejs": "0.10.2",
    "pixi.js": "8.20.1",
    "qrcode": "1.5.4",
    "socket.io": "4.8.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/howler": "2.2.12",
    "@types/node": "24.3.1",
    "@types/qrcode": "1.5.5",
    "@vitest/coverage-v8": "3.2.4",
    "socket.io-client": "4.8.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
